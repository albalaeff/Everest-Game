#!/bin/sh
# Refuse direct pushes to main: it changes only through pull requests (GitHub flow, #300).
# Turn it on once per clone:  git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "Refusing to push to ${remote_ref#refs/heads/}: it changes only through pull requests." >&2
      echo "Push a task branch (feature/<issue>-<description>) and open a PR into main." >&2
      exit 1
      ;;
  esac
done
exit 0
