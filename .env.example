# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every setting is read from a MYAPP_-prefixed environment variable or from .env
# (myapp/config.py).
#
# A line in .env pins its setting: it keeps that value when a release changes the default
# (#564). So a copy sets only what has to be filled in, the lines without "# " in front:
# blank, they're unset. Every other setting is a commented line at the code's default:
# uncomment it to change the setting.

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
# MYAPP_LOG_LEVEL=INFO
# Log lines as key=value text (readable in a terminal) or json (one object per line).
# MYAPP_LOG_FORMAT=text

# The database, as a SQLAlchemy-style URL: the docker compose dev database when the project
# has one (docker-compose.yml). Unset for a project without a database.
# MYAPP_DATABASE_URL=postgresql://myapp:myapp@localhost:5433/myapp
