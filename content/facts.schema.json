{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A file of the knowledge base's records: docs/conventions/knowledge-base.md",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "if": { "properties": { "kind": { "const": "coefficient" } }, "required": ["kind"] },
        "then": { "$ref": "#/$defs/coefficient" },
        "else": {
          "if": { "properties": { "kind": { "const": "question" } }, "required": ["kind"] },
          "then": { "$ref": "#/$defs/question" },
          "else": { "$ref": "#/$defs/fact" }
        }
      }
    }
  },
  "required": ["facts"],
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "description": "What the sources say, one version for each that disagrees.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "fact" },
        "claim": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
      },
      "required": ["id", "kind", "claim", "status", "versions"],
      "additionalProperties": false
    },
    "coefficient": {
      "description": "A number the model is tuned with that no source states: it names the facts it was fitted to and the date of the fit.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "coefficient" },
        "claim": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "value": { "type": "number" },
        "range": { "$ref": "#/$defs/range" },
        "unit": { "$ref": "#/$defs/text" },
        "fitted_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "fitted": { "$ref": "#/$defs/date" }
      },
      "required": ["id", "kind", "claim", "status", "unit", "fitted_to", "fitted"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/measured" }, { "$ref": "#/$defs/has-a-number" }]
    },
    "question": {
      "description": "What no source answers, for an expert: it's open until they answer it, and the answer is a fact.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "question" },
        "question": { "$ref": "#/$defs/text" },
        "about": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "required": ["id", "kind", "question"],
      "additionalProperties": false
    },
    "version": {
      "description": "What one source says: a value or a range with its unit, words in `note`, or just the claim as it stands.",
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "range": { "$ref": "#/$defs/range" },
        "unit": { "$ref": "#/$defs/text" },
        "estimate": {
          "description": "The source estimates the number instead of giving one that's listed or measured, as with a price no operator publishes: true, or left out.",
          "const": true
        },
        "note": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/source" },
        "checked": { "$ref": "#/$defs/date" }
      },
      "required": ["source", "checked"],
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/measured" }],
      "dependentSchemas": {
        "unit": { "$ref": "#/$defs/has-a-number" },
        "estimate": { "$ref": "#/$defs/has-a-number" }
      }
    },
    "measured": {
      "not": { "required": ["value", "range"] },
      "dependentRequired": { "value": ["unit"], "range": ["unit"] }
    },
    "has-a-number": {
      "anyOf": [{ "required": ["value"] }, { "required": ["range"] }]
    },
    "source": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "pattern": "^https?://\\S+$" }
      },
      "required": ["title", "url"],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": { "min": { "type": "number" }, "max": { "type": "number" } },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "status": { "enum": ["expert-reviewed", "source only"] },
    "text": { "type": "string", "minLength": 1 }
  }
}
