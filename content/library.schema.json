{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The medical library: docs/conventions/knowledge-base.md → The medical library",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "areas": {
      "description": "The knowledge base's areas whose records cite only the library.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "required": ["areas", "sources"],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "description": "A source read in full: what it is, where, its edition's year, what it's for, and the day it was read.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "published": { "type": "integer", "minimum": 1900 },
        "use": { "type": "string", "minLength": 1 },
        "read": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
      },
      "required": ["title", "url", "published", "use", "read"],
      "additionalProperties": false
    }
  }
}
