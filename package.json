{
  "name": "everest",
  "version": "0.1.0",
  "private": true,
  "description": "Everest, a browser simulator-trainer for climbing Everest",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "room": "wrangler dev",
    "lint": "eslint src e2e \"*.config.ts\"",
    "format": "prettier --write index.html src e2e \"*.config.*\"",
    "format:check": "prettier --check index.html src e2e \"*.config.*\"",
    "typecheck": "tsc && tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "three": "^0.170.0"
  }
}
